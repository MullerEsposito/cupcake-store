{
  "name": "cupcake-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env build/server/main.js",
    "dev": "node --import tsx scripts/dev.ts",
    "build": "npm run typecheck && vite build && npm run clean:server && node scripts/build-server.mjs",
    "clean:server": "node scripts/clean-server.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json && tsc -p tsconfig.tools.json",
    "test": "node --import tsx --test",
    "check:db": "node --import tsx --env-file-if-exists=.env scripts/check-db.ts",
    "check:sprint2": "node --import tsx --env-file-if-exists=.env scripts/check-sprint2.mjs",
    "check:sprint3": "node --import tsx --env-file-if-exists=.env scripts/check-sprint3.mjs",
    "check:sprint4": "node --import tsx --env-file-if-exists=.env scripts/check-sprint4.mjs"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "express": "^5.2.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typeorm": "^0.3.27",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "vite": "^7.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^20.19.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2"
  }
}
