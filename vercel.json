{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300,
      "includeFiles": "build/server/**"
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.mjs" }
  ]
}
