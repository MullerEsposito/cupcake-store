digraph Model {
graph [fontname="Arial", fontsize=18, label="Classes UML — Catálogo, carrinho e compra", labelloc=t, bgcolor="white", rankdir=TB, nodesep=0.4, ranksep=0.7, pad=0.3];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#77646a", penwidth=1.2, arrowsize=0.7, labeldistance=1.7];
usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>name: string<BR ALIGN="LEFT"/>email: string<BR ALIGN="LEFT"/>role: string<BR ALIGN="LEFT"/>active: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
endereco [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>Address</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>userId: string<BR ALIGN="LEFT"/>recipient: string<BR ALIGN="LEFT"/>postalCode: string<BR ALIGN="LEFT"/>street: string<BR ALIGN="LEFT"/>number: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
categoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>Category</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>name: string<BR ALIGN="LEFT"/>description: string | null<BR ALIGN="LEFT"/>active: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
produto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>Product</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>name: string<BR ALIGN="LEFT"/>price: string<BR ALIGN="LEFT"/>stock: number<BR ALIGN="LEFT"/>active: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
carrinho [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>Cart</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>userId: string | null<BR ALIGN="LEFT"/>guestHash: string | null<BR ALIGN="LEFT"/>state: 'ATIVO' | 'CONVERTIDO' | 'ABANDONADO'<BR ALIGN="LEFT"/>createdAt: Date<BR ALIGN="LEFT"/>updatedAt: Date<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
item_carrinho [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>CartItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>cartId: string<BR ALIGN="LEFT"/>productId: string<BR ALIGN="LEFT"/>quantity: number<BR ALIGN="LEFT"/>product: Relation&lt;Product&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>number: string<BR ALIGN="LEFT"/>userId: string<BR ALIGN="LEFT"/>status: string<BR ALIGN="LEFT"/>total: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
item_pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>OrderItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>orderId: string<BR ALIGN="LEFT"/>productId: string<BR ALIGN="LEFT"/>quantity: number<BR ALIGN="LEFT"/>unitPrice: string<BR ALIGN="LEFT"/>name: string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pagamento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>Payment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">id: string<BR ALIGN="LEFT"/>orderId: string<BR ALIGN="LEFT"/>method: string<BR ALIGN="LEFT"/>status: string<BR ALIGN="LEFT"/>amount: string<BR ALIGN="LEFT"/>processedAt: Date | null<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
usuario -> endereco [dir=both, arrowhead=none, arrowtail=none, label="possui", taillabel="1", headlabel="0..*"];
usuario -> carrinho [dir=both, arrowhead=none, arrowtail=none, label="mantém", taillabel="0..1", headlabel="0..*"];
categoria -> produto [dir=both, arrowhead=none, arrowtail=none, label="classifica", taillabel="1", headlabel="0..*"];
carrinho -> item_carrinho [dir=both, arrowhead=none, arrowtail=diamond, label="contém", taillabel="1", headlabel="0..*"];
produto -> item_carrinho [dir=both, arrowhead=none, arrowtail=none, label="selecionado em", taillabel="1", headlabel="0..*"];
usuario -> pedido [dir=both, arrowhead=none, arrowtail=none, label="realiza", taillabel="1", headlabel="0..*"];
endereco -> pedido [dir=both, arrowhead=none, arrowtail=none, label="utilizado em", taillabel="1", headlabel="0..*"];
pedido -> item_pedido [dir=both, arrowhead=none, arrowtail=diamond, label="compõe", taillabel="1", headlabel="1..*"];
produto -> item_pedido [dir=both, arrowhead=none, arrowtail=none, label="origina", taillabel="1", headlabel="0..*"];
pedido -> pagamento [dir=both, arrowhead=none, arrowtail=none, label="recebe tentativa", taillabel="1", headlabel="0..*"];
}
