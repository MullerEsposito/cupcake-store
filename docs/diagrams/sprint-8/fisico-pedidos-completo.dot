digraph Model {
graph [fontname="Arial", fontsize=18, label="Modelo físico — pedidos", labelloc=t, bgcolor="white", rankdir=TB, nodesep=0.4, ranksep=0.7, pad=0.3];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#77646a", penwidth=1.2, arrowsize=0.7, labeldistance=1.7];
usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>nome: varchar(150)<BR ALIGN="LEFT"/>email: varchar(254)<BR ALIGN="LEFT"/>senha_hash: text<BR ALIGN="LEFT"/>perfil: varchar(10)<BR ALIGN="LEFT"/>ativo: boolean<BR ALIGN="LEFT"/>tentativas_falhas: integer<BR ALIGN="LEFT"/>bloqueado_ate: timestamptz ?<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
endereco [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>endereco</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK usuario_id: bigint<BR ALIGN="LEFT"/>destinatario: varchar(150)<BR ALIGN="LEFT"/>cep: varchar(8)<BR ALIGN="LEFT"/>logradouro: varchar(200)<BR ALIGN="LEFT"/>numero: varchar(20)<BR ALIGN="LEFT"/>complemento: varchar(150) ?<BR ALIGN="LEFT"/>bairro: varchar(100)<BR ALIGN="LEFT"/>cidade: varchar(100)<BR ALIGN="LEFT"/>uf: varchar(2)<BR ALIGN="LEFT"/>ativo: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>numero: varchar(40)<BR ALIGN="LEFT"/>FK usuario_id: bigint<BR ALIGN="LEFT"/>FK endereco_id: bigint<BR ALIGN="LEFT"/>criado_em: timestamptz<BR ALIGN="LEFT"/>status: varchar(25)<BR ALIGN="LEFT"/>entrega_destinatario: varchar(150)<BR ALIGN="LEFT"/>entrega_cep: varchar(8)<BR ALIGN="LEFT"/>entrega_logradouro: varchar(200)<BR ALIGN="LEFT"/>entrega_numero: varchar(20)<BR ALIGN="LEFT"/>entrega_complemento: varchar(150) ?<BR ALIGN="LEFT"/>entrega_bairro: varchar(100)<BR ALIGN="LEFT"/>entrega_cidade: varchar(100)<BR ALIGN="LEFT"/>entrega_uf: varchar(2)<BR ALIGN="LEFT"/>subtotal: numeric(12,2)<BR ALIGN="LEFT"/>frete: numeric(12,2)<BR ALIGN="LEFT"/>total: numeric(12,2)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
item_pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>item_pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK pedido_id: bigint<BR ALIGN="LEFT"/>FK produto_id: bigint<BR ALIGN="LEFT"/>quantidade: integer<BR ALIGN="LEFT"/>preco_unitario: numeric(12,2)<BR ALIGN="LEFT"/>nome_produto_snapshot: varchar(150)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
produto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>produto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK categoria_id: bigint<BR ALIGN="LEFT"/>nome: varchar(150)<BR ALIGN="LEFT"/>descricao: text<BR ALIGN="LEFT"/>preco: numeric(12,2)<BR ALIGN="LEFT"/>peso_gramas: numeric(10,3)<BR ALIGN="LEFT"/>imagem_url: text<BR ALIGN="LEFT"/>ativo: boolean<BR ALIGN="LEFT"/>estoque_disponivel: integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pagamento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>pagamento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK pedido_id: bigint<BR ALIGN="LEFT"/>metodo: varchar(10)<BR ALIGN="LEFT"/>status: varchar(10)<BR ALIGN="LEFT"/>valor: numeric(12,2)<BR ALIGN="LEFT"/>criado_em: timestamptz<BR ALIGN="LEFT"/>processado_em: timestamptz ?<BR ALIGN="LEFT"/>chave_idempotencia: varchar(128)<BR ALIGN="LEFT"/>simulado: boolean<BR ALIGN="LEFT"/>motivo_resultado: text ?<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
usuario -> endereco [dir=both, arrowhead=none, arrowtail=none, label="possui", taillabel="1", headlabel="0..*"];
usuario -> pedido [dir=both, arrowhead=none, arrowtail=none, label="realiza", taillabel="1", headlabel="0..*"];
endereco -> pedido [dir=both, arrowhead=none, arrowtail=none, label="utilizado em", taillabel="1", headlabel="0..*"];
pedido -> item_pedido [dir=both, arrowhead=none, arrowtail=none, label="compõe", taillabel="1", headlabel="0..*"];
produto -> item_pedido [dir=both, arrowhead=none, arrowtail=none, label="origina", taillabel="1", headlabel="0..*"];
pedido -> pagamento [dir=both, arrowhead=none, arrowtail=none, label="recebe tentativa", taillabel="1", headlabel="0..*"];
}
