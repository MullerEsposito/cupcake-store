digraph Model {
graph [fontname="Arial", fontsize=18, label="Modelo físico — pedidos", labelloc=t, bgcolor="white", rankdir=TB, nodesep=0.4, ranksep=0.7, pad=0.3];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#77646a", penwidth=1.2, arrowsize=0.7, labeldistance=1.7];
usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
endereco [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>endereco</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK usuario_id: bigint<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK usuario_id: bigint<BR ALIGN="LEFT"/>FK endereco_id: bigint<BR ALIGN="LEFT"/>status: varchar(25)<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
item_pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>item_pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK pedido_id: bigint<BR ALIGN="LEFT"/>FK produto_id: bigint<BR ALIGN="LEFT"/>quantidade: integer<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
produto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>produto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK categoria_id: bigint<BR ALIGN="LEFT"/>preco: numeric(12,2)<BR ALIGN="LEFT"/>estoque_disponivel: integer<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pagamento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>pagamento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK pedido_id: bigint<BR ALIGN="LEFT"/>status: varchar(10)<BR ALIGN="LEFT"/>simulado: boolean<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
usuario -> endereco [dir=both, arrowhead=none, arrowtail=none, label="possui", taillabel="1", headlabel="0..*"];
usuario -> pedido [dir=both, arrowhead=none, arrowtail=none, label="realiza", taillabel="1", headlabel="0..*"];
endereco -> pedido [dir=both, arrowhead=none, arrowtail=none, label="utilizado em", taillabel="1", headlabel="0..*"];
pedido -> item_pedido [dir=both, arrowhead=none, arrowtail=none, label="compõe", taillabel="1", headlabel="0..*"];
produto -> item_pedido [dir=both, arrowhead=none, arrowtail=none, label="origina", taillabel="1", headlabel="0..*"];
pedido -> pagamento [dir=both, arrowhead=none, arrowtail=none, label="recebe tentativa", taillabel="1", headlabel="0..*"];
}
