digraph Model {
graph [fontname="Arial", fontsize=18, label="Modelo físico — auditoria", labelloc=t, xlabel="Multiplicidade na legenda da ligação: origem / destino", bgcolor="white", rankdir=TB, nodesep=0.4, ranksep=0.7, pad=0.3];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#77646a", penwidth=1.2, arrowsize=0.7, labeldistance=1.7];
usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
produto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>produto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK usuario_id: bigint<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pagamento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>pagamento</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
cancelamento_pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>cancelamento_pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK pedido_id: bigint<BR ALIGN="LEFT"/>FK usuario_id: bigint<BR ALIGN="LEFT"/>FK pagamento_id: bigint ?<BR ALIGN="LEFT"/>valor_estorno: numeric(12,2)<BR ALIGN="LEFT"/>simulado: boolean<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
movimentacao_estoque [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>movimentacao_estoque</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK produto_id: bigint<BR ALIGN="LEFT"/>tipo: varchar(20)<BR ALIGN="LEFT"/>quantidade: integer<BR ALIGN="LEFT"/>saldo_anterior: integer<BR ALIGN="LEFT"/>saldo_posterior: integer<BR ALIGN="LEFT"/>FK usuario_id: bigint ?<BR ALIGN="LEFT"/>FK pedido_id: bigint ?<BR ALIGN="LEFT"/>… dicionário completo na seção 15.6<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
pedido -> cancelamento_pedido [dir=both, arrowhead=none, arrowtail=none, label="pode ter\n1 / 0..1"];
usuario -> cancelamento_pedido [dir=both, arrowhead=none, arrowtail=none, label="registra\n1 / 0..*"];
pagamento -> cancelamento_pedido [dir=both, arrowhead=none, arrowtail=none, label="referência de estorno\n0..1 / 0..1"];
produto -> movimentacao_estoque [dir=both, arrowhead=none, arrowtail=none, label="movimenta\n1 / 0..*"];
usuario -> movimentacao_estoque [dir=both, arrowhead=none, arrowtail=none, label="é autor de\n0..1 / 0..*"];
pedido -> movimentacao_estoque [dir=both, arrowhead=none, arrowtail=none, label="vincula\n0..1 / 0..*"];
pagamento -> movimentacao_estoque [dir=both, arrowhead=none, arrowtail=none, label="vincula\n0..1 / 0..*"];
cancelamento_pedido -> movimentacao_estoque [dir=both, arrowhead=none, arrowtail=none, label="vincula devolução\n0..1 / 0..*"];
}
