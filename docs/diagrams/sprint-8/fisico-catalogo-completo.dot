digraph Model {
graph [fontname="Arial", fontsize=18, label="Modelo físico — catalogo", labelloc=t, bgcolor="white", rankdir=TB, nodesep=0.4, ranksep=0.7, pad=0.3];
node [shape=plain, fontname="Arial", fontsize=12];
edge [fontname="Arial", fontsize=10, color="#77646a", penwidth=1.2, arrowsize=0.7, labeldistance=1.7];
usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>nome: varchar(150)<BR ALIGN="LEFT"/>email: varchar(254)<BR ALIGN="LEFT"/>senha_hash: text<BR ALIGN="LEFT"/>perfil: varchar(10)<BR ALIGN="LEFT"/>ativo: boolean<BR ALIGN="LEFT"/>tentativas_falhas: integer<BR ALIGN="LEFT"/>bloqueado_ate: timestamptz ?<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
categoria [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>categoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>nome: varchar(100)<BR ALIGN="LEFT"/>descricao: text ?<BR ALIGN="LEFT"/>ativo: boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
produto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>produto</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK categoria_id: bigint<BR ALIGN="LEFT"/>nome: varchar(150)<BR ALIGN="LEFT"/>descricao: text<BR ALIGN="LEFT"/>preco: numeric(12,2)<BR ALIGN="LEFT"/>peso_gramas: numeric(10,3)<BR ALIGN="LEFT"/>imagem_url: text<BR ALIGN="LEFT"/>ativo: boolean<BR ALIGN="LEFT"/>estoque_disponivel: integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
carrinho [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>carrinho</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK usuario_id: bigint ?<BR ALIGN="LEFT"/>token_sessao: varchar(128) ?<BR ALIGN="LEFT"/>criado_em: timestamptz<BR ALIGN="LEFT"/>atualizado_em: timestamptz<BR ALIGN="LEFT"/>estado: varchar(12)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
item_carrinho [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#b99da6"><TR><TD BGCOLOR="#783b4a"><FONT COLOR="white"><B>item_carrinho</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fffaf5">PK id: bigint<BR ALIGN="LEFT"/>FK carrinho_id: bigint<BR ALIGN="LEFT"/>FK produto_id: bigint<BR ALIGN="LEFT"/>quantidade: integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
usuario -> carrinho [dir=both, arrowhead=none, arrowtail=none, label="mantém", taillabel="0..1", headlabel="0..*"];
categoria -> produto [dir=both, arrowhead=none, arrowtail=none, label="classifica", taillabel="1", headlabel="0..*"];
carrinho -> item_carrinho [dir=both, arrowhead=none, arrowtail=none, label="contém", taillabel="1", headlabel="0..*"];
produto -> item_carrinho [dir=both, arrowhead=none, arrowtail=none, label="selecionado em", taillabel="1", headlabel="0..*"];
}
